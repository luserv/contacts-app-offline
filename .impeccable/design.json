  "narrative": {
    "northStar": "The Quiet Ledger",
    "overview": "A private ledger that records everything about a person and says nothing about itself. The interface borrows the system vocabulary so the user recognizes patterns instead of learning a brand.",
    "keyCharacteristics": [
      "Native-feeling: iOS palette, system font, hairline separators.",
      "Flat at rest: depth comes from tonal layering.",
      "One accent (system blue) for every interactive affordance.",
      "Light and dark themes with parallel tokens.",
      "Touch targets of at least 48px."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "System blue is the only accent. Red and green mark state, amber marks birthdays; none of them decorate.",
        "section": "colors"
      },
      {
        "name": "The Native Palette Rule",
        "body": "New colors come from the iOS system palette.",
        "section": "colors"
      },
      {
        "name": "The System Font Rule",
        "body": "Do not add a custom typeface. Hierarchy comes from weight and size steps.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "No shadow is stronger than 0.10 opacity. Depth is a surface step, not a drop shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use system blue for every interactive element and nothing else.",
      "Do keep every touch target at 48px minimum.",
      "Do build new surfaces from the existing card and filled input.",
      "Do provide light and dark values for every new color token.",
      "Do keep copy short and literal."
    ],
    "donts": [
      "Don't use CRM patterns: metric panels, endless tables, corporate blue headers.",
      "Don't add social cues: badges, engagement counts, audience logic.",
      "Don't use colored left or right stripe borders as alert accents.",
      "Don't add custom fonts, gradients, or glass effects.",
      "Don't nest cards inside cards or repeat identical icon-heading-text card grids."
    ]
  }
