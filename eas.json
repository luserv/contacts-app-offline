{
    "cli": {
        "version": ">= 7.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "APP_ENV": "development"
            }
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "APP_ENV": "preview"
            }
        },
        "production": {
            "channel": "production",
            "android": {
                "buildType": "app-bundle"
            },
            "env": {
                "APP_ENV": "production",
                "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "461026464928-uqthqedb0oekcl2rgch1ggq9rkf6f3gq.apps.googleusercontent.com",
                "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "461026464928-uqthqedb0oekcl2rgch1ggq9rkf6f3gq.apps.googleusercontent.com",
                "EXPO_PUBLIC_ADMOB_APP_ID": "ca-app-pub-3940256099942544~3347511713",
                "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "goog_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
            }
        },
        "production-apk": {
            "extends": "production",
            "android": {
                "buildType": "apk"
            }
        }
    },
    "submit": {
        "production": {
            "android": {
                "track": "internal"
            }
        }
    }
}
