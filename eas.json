{
    "cli": {
        "version": ">= 7.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "APP_ENV": "development"
            }
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "APP_ENV": "preview"
            }
        },
        "production": {
            "channel": "production",
            "android": {
                "buildType": "app-bundle"
            },
            "env": {
                "APP_ENV": "production"
            }
        }
    },
    "submit": {
        "production": {
            "android": {
                "track": "internal"
            }
        }
    }
}
