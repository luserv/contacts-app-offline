{
  "name": "contacts",
  "description": "app to save your contacts",
  "author": "luserv",
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.33.0",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "android:dev": "expo run:android",
    "android:preview": "cross-env APP_ENV=preview expo run:android",
    "android:prod": "cross-env APP_ENV=production expo run:android",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "build:prod-apk": "eas build --profile production-apk --platform android",
    "sqlite:init": "node scripts/init-sqlite.mjs",
    "sqlite:seed": "node scripts/init-sqlite.mjs --seed",
    "generate:ico": "node scripts/generate-ico.mjs",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "electron:dev": "cross-env NODE_ENV=development electron electron/main.js",
    "electron:preview": "cross-env NODE_ENV=development APP_ENV=preview electron electron/main.js",
    "electron:build": "expo export --platform web --output-dir dist && electron-builder --config electron-builder.json",
    "electron:win": "electron-rebuild -f -w better-sqlite3 && expo export --platform web --output-dir dist && electron-builder --win --config electron-builder.json",
    "electron:mac": "electron-rebuild -f -w better-sqlite3 && expo export --platform web --output-dir dist && electron-builder --mac --config electron-builder.json",
    "electron:linux": "electron-rebuild -f -w better-sqlite3 && expo export --platform web --output-dir dist && electron-builder --linux --config electron-builder.json",
    "postinstall": "cp node_modules/sql.js/dist/sql-wasm.wasm public/sql-wasm.wasm"
  },
  "dependencies": {
    "@electron/get": "^5.0.0",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/elements": "^2.9.18",
    "@react-navigation/native": "^7.2.4",
    "date-fns": "^4.1.0",
    "expo": "~54.0.35",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "^57.0.3",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "extract-zip": "^2.0.1",
    "firebase": "^12.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-purchases": "^10.2.2",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.3",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.19",
    "@types/react": "~19.1.17",
    "@types/sql.js": "^1.4.11",
    "babel-preset-expo": "~54.0.10",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "39.8.5",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "wait-on": "^9.0.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/bottom-tabs",
        "@react-navigation/native"
      ]
    }
  }
}
